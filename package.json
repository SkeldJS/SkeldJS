{
  "name": "skeldjs",
  "description": "SkeldJS - A JavaScript implementation of the Among Us protocol and the Waterway server, written in TypeScript.",
  "keywords": [
    "amongus",
    "among us",
    "server",
    "waterway"
  ],
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "build": "yarn workspaces foreach -Aptv run build",
    "build:packages": "yarn workspaces foreach -Aptv --include 'packages/*' run build",
    "build:waterway": "yarn workspace @skeldjs/waterway build",
    "start": "yarn workspace @skeldjs/waterway start",
    "dev": "yarn workspace @skeldjs/waterway dev",
    "setup": "yarn workspace @skeldjs/waterway setup"
  },
  "workspaces": [
    "packages/*",
    "waterway"
  ],
  "version": "3.0.3",
  "packageManager": "yarn@4.10.3"
}
